{
  "name": "whwdzg-site",
  "private": true,
  "version": "3.9.7",
  "type": "module",
  "description": "沧海水鱼内容站点 3.9.7 —— 数据包、影像归档、GitHub 评论区、子站与站内工具",
  "homepage": "https://whwdzg.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/whwdzg/whwdzg.github.io.git"
  },
  "license": "GPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/generate-meta.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-meta.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:videos": "node scripts/build-videos-data.mjs",
    "data:projects": "node scripts/build-project-data.mjs",
    "data:sync": "node --dns-result-order=ipv4first scripts/sync-all.mjs",
    "data:github": "node --dns-result-order=ipv4first scripts/sync-github.mjs",
    "data:modrinth": "node --dns-result-order=ipv4first scripts/sync-modrinth.mjs",
    "data:mcmod": "node --dns-result-order=ipv4first scripts/sync-mcmod.mjs",
    "data:mcmod-comments": "node --dns-result-order=ipv4first scripts/sync-mcmod-comments.mjs",
    "data:bilibili": "node --dns-result-order=ipv4first scripts/sync-bilibili-space.mjs",
    "data:collections": "node --dns-result-order=ipv4first scripts/sync-bilibili-seasons.mjs",
    "fetch:covers": "node scripts/fetch-covers.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.321",
    "dompurify": "^3.4.18",
    "jszip": "^3.10.2",
    "marked": "^18.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
